# این فایل رو کپی کنید و اسمش رو بذارید .env (نه .env.example)
# سپس مقادیر واقعی خودتون رو جایگزین کنید. فایل .env هیچ‌وقت نباید به گیت‌هاب پوش بشه.

# آدرس اتصال دیتابیس Postgres - از Neon.tech (یا هر سرویس دیگه) بگیرید
# نمونه: postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/anketnevis?sslmode=require
DATABASE_URL=

# یک رشته‌ی تصادفی و طولانی برای امضای توکن‌های JWT (هرگز آن را به اشتراک نگذارید)
JWT_SECRET=

# پورتی که سرور بک‌اند روی آن اجرا می‌شود
PORT=4000

# آدرس فرانت‌اند شما، برای تنظیم CORS
CLIENT_ORIGIN=http://localhost:5173

# برای ارسال کد تأیید ورود از طریق ایمیل (Gmail)
# EMAIL_USER: آدرس جیمیل شما
# EMAIL_APP_PASSWORD: یک «App Password» ۱۶ کاراکتری (نه رمز عبور اصلی جیمیل!)
# راهنما: در تنظیمات حساب گوگل > Security > 2-Step Verification را فعال کنید،
# سپس به myaccount.google.com/apppasswords بروید و یک رمز برای "Mail" بسازید.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# یک کد مخفی و طولانی برای ساخت اولین حساب ادمین (رئیس نویسندگان).
# این کد را به هیچ‌کس ندهید. صفحه‌ی ساخت ادمین با آدرس زیر باز می‌شود:
# http://localhost:5173/?admin_setup=همین-کد-را-اینجا-بگذارید
ADMIN_SETUP_CODE=

# ---------------------------------------------------------------------------
# درگاه پرداخت زرین‌پال
# ---------------------------------------------------------------------------
# حالت آزمایشی (پیش‌فرض): ZARINPAL_SANDBOX=true. در این حالت هیچ پول واقعی جابه‌جا نمی‌شود
# و حتی اگر ZARINPAL_MERCHANT_ID خالی باشد، یک کد آزمایشی خودکار استفاده می‌شود.
# برای پرداخت واقعی: در پنل زرین‌پال «مرچنت‌کد» ۳۶ کاراکتری بگیرید، آن را اینجا بگذارید
# و ZARINPAL_SANDBOX=false کنید.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# آدرس عمومی همین بک‌اند؛ زرین‌پال بعد از پرداخت کاربر را به BACKEND_URL/api/payments/callback برمی‌گرداند
BACKEND_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# فقط روی سرور واقعی
# ---------------------------------------------------------------------------
# روی سرور واقعی production بگذارید؛ در این حالت تنظیمات ناامن (مثلاً آدرس localhost) سرور را متوقف می‌کند
# NODE_ENV=production

# مسیر پوشه‌ی فایل‌های آپلودشده؛ روی یک دیسک دائمی (Volume) بگذارید، مثلاً /data/uploads
# UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------------------
# امنیت نشست، پروکسی و دیتابیس
# ---------------------------------------------------------------------------
# کوکی ورود: lax (پیش‌فرض) وقتی فرانت و بک‌اند زیردامنه‌ی یک دامنه‌اند (app.example.ir و api.example.ir).
# اگر دو دامنه‌ی کاملاً جدا دارید none بگذارید (در بعضی مرورگرها کوکی شخص ثالث مسدود است؛ بهتر است زیردامنه‌ی یک دامنه باشند).
# COOKIE_SAMESITE=lax

# تعداد پروکسی‌های جلوی بک‌اند برای تشخیص آی‌پی واقعی کاربر (Railway/Render/Nginx معمولاً ۱). در production پیش‌فرض ۱ است.
# TRUST_PROXY=1

# گواهی TLS دیتابیس در production راستی‌آزمایی می‌شود. اگر سرویس دیتابیس شما گواهی خودامضا دارد
# گواهی ریشه را در DB_SSL_CA بگذارید، یا (کم‌امن‌تر) این را false کنید:
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=

# ---------------------------------------------------------------------------
# رله‌ی ایمیل با Google Apps Script (جایگزین Brevo برای کسانی که به آن دسترسی ندارند)
# فایل mail-relay/Code.gs را در script.google.com بسازید و آدرس /exec و توکن را اینجا بگذارید.
# ایمیل‌ها از حساب جیمیل صاحب اسکریپت می‌روند (سقف حدود ۱۰۰ گیرنده در روز برای جیمیل شخصی).
# ---------------------------------------------------------------------------
# MAIL_RELAY_URL=https://script.google.com/macros/s/XXXX/exec
# MAIL_RELAY_TOKEN=
