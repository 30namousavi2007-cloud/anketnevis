# --- حالت ۱ (پیشنهادی روی Render Static Site): API هم‌مبدأ با سایت، با Rewrite ---
# در Render روی Static Site یک Rewrite بسازید:  /api/*  ←  https://BACKEND.onrender.com/api/*
# سپس این‌ها را بگذارید (VITE_FILES_URL برای پخش فایل‌ها مستقیم از بک‌اند است):
VITE_API_URL=/
VITE_FILES_URL=https://BACKEND.onrender.com

# --- حالت ۲: اتصال مستقیم به بک‌اند (نیازمند دامنه‌ی شخصی با زیردامنه‌ها یا COOKIE_SAMESITE=none) ---
# VITE_API_URL=https://api.example.ir      <- فقط تا خود دامنه، بدون /api و بدون اسلش آخر
# محلی: اصلاً چیزی نگذارید یا VITE_API_URL=http://localhost:4000

# مقدار VITE_ هنگام بیلد خوانده می‌شود؛ بعد از هر تغییر باید دوباره Deploy کنید.
